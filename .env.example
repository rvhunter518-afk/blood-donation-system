# BloodConnect — Call System Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials to version control.
#
# For XAMPP development: edit config/call.php directly.
# This file is for documentation/reference only.

# ── OPERATIONAL MODE ──────────────────────────────────────────
# 'test'       = Simulate calls, no real API calls, no cost
# 'production' = Use real telephony provider
CALL_MODE=test

# ── ACTIVE PROVIDER ───────────────────────────────────────────
# Options: twilio | exotel | plivo
CALL_PROVIDER=twilio

# ── TWILIO ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_WEBHOOK_URL=https://yourdomain.com/api/call/webhook.php

# ── EXOTEL (India) ────────────────────────────────────────────
EXOTEL_API_KEY=your_api_key
EXOTEL_API_TOKEN=your_api_token
EXOTEL_FROM_NUMBER=0XXXXXXXXXX
EXOTEL_APP_ID=your_app_id
EXOTEL_WEBHOOK_URL=https://yourdomain.com/api/call/webhook.php

# ── PLIVO ─────────────────────────────────────────────────────
PLIVO_AUTH_ID=your_auth_id
PLIVO_AUTH_TOKEN=your_auth_token
PLIVO_FROM_NUMBER=+91XXXXXXXXXX
PLIVO_WEBHOOK_URL=https://yourdomain.com/api/call/webhook.php

# ── RATE LIMITING ─────────────────────────────────────────────
CALL_RATE_LIMIT_MAX=5
CALL_RATE_LIMIT_WINDOW_MINUTES=10
CALL_COOLDOWN_SECONDS=60

